{
  "name": "data-cloud-inspector",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build-privacy.mjs && vite build && vite build --config vite.sw.config.js",
    "build:public": "node scripts/build-privacy.mjs && vite build --mode public && vite build --config vite.sw.config.js --mode public",
    "test": "vitest run",
    "test:watch": "vitest",
    "privacy": "node scripts/build-privacy.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:verify": "node scripts/package.mjs --verify"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "3.1.1",
    "codemirror": "^6.0.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "sql-formatter": "^15.9.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
